# Binance (read-only key is sufficient — the scanner only reads public market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (optional — signals are always written to the log file regardless)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_TOPIC_THREAD_ID=

# Logging
# LOG_FILE=signal_bot_reversal.log
# LOG_LEVEL=INFO

# Universe / liquidity (defaults shown)
# TOP_N=300
# MIN_VOL_BINANCE=5000000
# MIN_VOL_BITGET=1000000
# MIN_VOL_30D_USD=10000000

# Detector toggles (1 = on)
# SQUEEZE_DETECTOR_ENABLED=1
# FAILED_BD_DETECTOR_ENABLED=1
# SWEEP_DETECTOR_ENABLED=1

# Filter stack (defaults shown)
# RSI_OVERSOLD_MAX=70
# ATR_PCT_4H_MIN_ENABLED=1
# ATR_PCT_4H_MIN=0.04
# DOW_HOUR_BLACKLIST_ENABLED=1
# COHORT_FILTER_ENABLED=1
# MTF_1H_CONFIRM_ENABLED=1
# BTC_GATE_ENABLED=0

# Signal behaviour
# SIGNAL_COOLDOWN_H=24
# REGIME_ADAPTIVE_TP_ENABLED=1
