# funding-arb-research — environment variables
#
# Backtesting and data collection for public endpoints (Binance, Bybit, OKX,
# Hyperliquid, GMX v2) require NO API keys.
#
# The following are only needed if you run the live recorder (src/recorder/)
# or the on-chain GMX v2 RPC collector.

# ── Live recorder (Binance) ──────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Live recorder (Bitget) ───────────────────────────────────────────────────
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ── GMX v2 on-chain RPC (optional) ──────────────────────────────────────────
# Public Arbitrum RPC works for read-only calls; a private node is faster.
ARBITRUM_RPC_URL=

# ── GMX v2 contract addresses (optional overrides) ──────────────────────────
# Defaults are read from config/venues.yaml. Override here if they change.
GMX_READER_ADDRESS=
GMX_DATA_STORE_ADDRESS=
