# Copy to .env and fill as needed. All values are optional — the recorder runs
# on public Hyperliquid market data with no keys. Defaults shown in comments.

# ── Recorder (hl_l2_recorder.py) ─────────────────────────────────────────────
# Hyperliquid public websocket — no API key, no auth, market data only.
# default: wss://api.hyperliquid.xyz/ws
HL_WS_URL=
# Output root for the gzip-JSONL corpus.  default: ./data
HL_MM_OUT=
# Comma-separated coin universe. Perps by symbol (BTC, ETH…); spot by index
# (@107) or pair (PURR/USDC).
# default: BTC,ETH,SOL,HYPE,XRP,DOGE,SUI,ZEC,AVAX,LINK,PURR/USDC,@107
HL_MM_COINS=

# ── Watchdog (hl_mm_watchdog.py) — optional, for systemd-timer monitoring ─────
# HL_MM_DATA default ./data ; HL_MM_UNIT default hl-mm-recorder
HL_MM_DATA=
HL_MM_UNIT=
# Telegram alert on capture failure (optional — prints to stdout if unset).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Thresholds (defaults): WD_HEALTH_AGE_S=180 WD_CHANNEL_STALE_S=600
# WD_MAX_FILE_AGE_S=300 WD_MIN_FREE_GB=10 WD_ALERT_COOLDOWN_S=1800

# ── Universe manager (hl_universe_manager.py) — optional auto-rotation ────────
# Install prefix for deploy mode (writes a systemd drop-in).  default: /opt/hl_mm
HL_MM_BASE=
